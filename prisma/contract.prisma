// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

enum BillStatus {
  PENDING_REVIEW
  CONFIRMED
}
namespace public {
  model Bill {
    id Int @id(map: "bill_pkey") @default(autoincrement())
    imageUrl String
    vendorName String
    vendorPan String
    billDateBs String?
    billDateAd DateTime?
    subTotal NumericString(12, 2)?
    vat NumericString(12, 2)?
    total NumericString(12, 2)?
    status BillStatus @default(PENDING_REVIEW)
    rawOcrText String?
    items BillItem[]
    createdAt DateTime(precision: 6) @default(now()) @map("created_at")
    @@rls
  }

  model BillItem {
    id Int @id(map: "bill_item_pkey") @default(autoincrement())
    billId Int
    itemName String
    quantity NumericString(12, 2)?
    unitPrice NumericString(12, 2)?
    totalPrice NumericString(12, 2)?
    bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  }

  policy_select bill {
    target = Bill
    roles = [public]
    using = sql`status = 'CONFIRMED'`
  }
}